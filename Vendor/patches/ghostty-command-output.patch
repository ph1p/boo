+    /// Writes the OSC 133 prompts that start in the viewport into `out`,
+    /// newest first, and returns how many it wrote.
+    export fn ghostty_surface_prompt_marks(
+        surface: *Surface,
+        out: [*]PromptMark,
+        cap: usize,
+    ) usize {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        var marks: [256]terminal.Screen.PromptMark = undefined;
+        const n = screen.viewportPromptMarks(marks[0..@min(cap, marks.len)]);
+        for (marks[0..n], 0..) |mark, i| {
+            const pt = screen.pages.pointFromPin(.viewport, mark.pin) orelse continue;
+            out[i] = .{
+                .row = @intCast(pt.coord().y),
+                .index = @intCast(mark.index),
+                .status = @intFromEnum(mark.status),
+            };
+        }
+        return n;
+    }
