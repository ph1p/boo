+
+test "Screen: command marks and selectCommand" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var s = try init(io, alloc, .{ .cols = 10, .rows = 10, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+
+    // Row 0: "$ " + "ls"        (command 1, fails)
+    // Row 1: "a"                (output 1)
+    // Row 2: "$ " + "pwd"       (command 2, succeeds)
+    // Row 3: "/tmp"             (output 2)
+    // Row 4: "$ "               (current prompt)
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+    s.cursorSetSemanticContent(.{ .input = .clear_explicit });
+    try s.testWriteString("ls\n");
+    s.cursorSetSemanticContent(.output);
+    try s.testWriteString("a\n");
+    s.markCommandStatus(1);
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+    s.cursorSetSemanticContent(.{ .input = .clear_explicit });
+    try s.testWriteString("pwd\n");
+    s.cursorSetSemanticContent(.output);
+    try s.testWriteString("/tmp\n");
+    s.markCommandStatus(null);
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+
+    var marks: [8]PromptMark = undefined;
+    const n = s.viewportPromptMarks(&marks);
+    try testing.expectEqual(@as(usize, 3), n);
+    try testing.expectEqual(@as(usize, 0), marks[0].index);
+    try testing.expectEqual(Row.CommandStatus.none, marks[0].status);
+    try testing.expectEqual(Row.CommandStatus.succeeded, marks[1].status);
+    try testing.expectEqual(Row.CommandStatus.failed, marks[2].status);
+    try testing.expectEqual(point.Point{ .viewport = .{ .x = 0, .y = 2 } }, s.pages.pointFromPin(.viewport, marks[1].pin).?);
+
+    // The newest prompt has no output yet; the one before it does.
+    try testing.expect(s.selectCommand(0, .output) == null);
+    {
+        var sel = s.selectCommand(1, .output).?;
+        defer sel.deinit(&s);
+        const contents = try s.selectionString(alloc, .{ .sel = sel, .trim = true });
+        defer alloc.free(contents);
+        try testing.expectEqualStrings("/tmp", contents);
+    }
+    {
+        var sel = s.selectCommand(2, .input).?;
+        defer sel.deinit(&s);
+        const contents = try s.selectionString(alloc, .{ .sel = sel, .trim = true });
+        defer alloc.free(contents);
+        try testing.expectEqualStrings("ls", contents);
+    }
+    try testing.expect(s.selectCommand(3, .output) == null);
+
+    // A row in output 1 belongs to the oldest prompt.
+    const row1 = s.pages.pin(.{ .active = .{ .x = 0, .y = 1 } }).?;
+    try testing.expectEqual(@as(?usize, 2), s.promptIndex(row1));
+}
