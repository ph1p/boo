+/// A shell prompt in the viewport, for gutter marks.
+pub const PromptMark = struct {
+    /// The prompt's first row.
+    pin: Pin,
+    /// 0 for the newest prompt on the screen, counting up into history.
+    index: usize,
+    status: Row.CommandStatus,
+};
+
+/// Records how the command above the cursor ended on its prompt row.
+/// Called on OSC 133 D; a missing exit code counts as success.
+pub fn markCommandStatus(self: *Screen, exit_code: ?i32) void {
+    if (!self.semantic_prompt.seen) return;
+    var it = self.cursor.page_pin.promptIterator(.left_up, null);
+    const prompt = it.next() orelse return;
+    prompt.rowAndCell().row.command_status =
+        if ((exit_code orelse 0) == 0) .succeeded else .failed;
+}
+
+/// The first row of the prompt `index` prompts back from the newest one.
+pub fn promptPin(self: *Screen, index: usize) ?Pin {
+    if (!self.semantic_prompt.seen) return null;
+    const bottom = self.pages.getBottomRight(.screen) orelse return null;
+    var it = bottom.promptIterator(.left_up, null);
+    var i: usize = 0;
+    while (it.next()) |prompt| : (i += 1) {
+        if (i == index) return prompt;
+    }
+    return null;
+}
+
+/// The index (see `promptPin`) of the prompt at or above `pin`.
+pub fn promptIndex(self: *Screen, pin: Pin) ?usize {
+    if (!self.semantic_prompt.seen) return null;
+    var above = pin.promptIterator(.left_up, null);
+    const target = above.next() orelse return null;
+    const bottom = self.pages.getBottomRight(.screen) orelse return null;
+    var it = bottom.promptIterator(.left_up, null);
+    var i: usize = 0;
+    while (it.next()) |prompt| : (i += 1) {
+        if (prompt.eql(target)) return i;
+    }
+    return null;
+}
+
+/// The input or output of the command at prompt `index` (see `promptPin`),
+/// or null if it has none.
+pub fn selectCommand(
+    self: *Screen,
+    index: usize,
+    content: Cell.SemanticContent,
+) ?Selection {
+    const prompt = self.promptPin(index) orelse return null;
+    const hl = self.pages.highlightSemanticContent(prompt, content) orelse return null;
+    return .init(hl.start, hl.end, false);
+}
+
+/// Fills `out` with the prompts that start in the viewport, newest first,
+/// and returns how many it wrote.
+pub fn viewportPromptMarks(self: *Screen, out: []PromptMark) usize {
+    if (!self.semantic_prompt.seen or out.len == 0) return 0;
+    const bottom = self.pages.getBottomRight(.screen) orelse return 0;
+    const top = self.pages.getTopLeft(.viewport);
+    var it = bottom.promptIterator(.left_up, null);
+    var index: usize = 0;
+    var n: usize = 0;
+    while (it.next()) |prompt| : (index += 1) {
+        if (prompt.before(top)) break;
+        if (self.pages.pointFromPin(.viewport, prompt) == null) continue;
+        out[n] = .{
+            .pin = prompt,
+            .index = index,
+            .status = prompt.rowAndCell().row.command_status,
+        };
+        n += 1;
+        if (n == out.len) break;
+    }
+    return n;
+}
