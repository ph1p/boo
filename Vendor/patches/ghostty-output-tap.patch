+/// Process output fed by the apprt thread (recording playback) rather
+/// than the pty. Never blocks on a full surface mailbox.
+pub fn processReplayOutput(self: *Termio, buf: []const u8) void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const handler = &self.terminal_stream.handler;
+    handler.replaying = true;
+    defer handler.replaying = false;
+    self.processOutputLocked(buf);
+}
+
 /// Process output from readdata but the lock is already held.
 fn processOutputLocked(self: *Termio, buf: []const u8) void {
+    if (self.output_cb) |cb| cb(self.output_userdata, buf.ptr, buf.len);
+
     // Schedule a render. We can call this first because we have the lock.
     self.terminal_stream.handler.queueRender() catch unreachable;
 
