+    /// Tap the raw pty output of a surface (before parsing) and its grid
+    /// resizes, or clear the tap with null callbacks. The callbacks run on
+    /// the termio thread with the terminal lock held: copy and return.
+    ///
+    /// With `snapshot`, the tap first receives the current grid size and the
+    /// terminal state as VT sequences (modes, screen contents, cursor,
+    /// palette, scrolling region), taken under the same lock that installs
+    /// the tap, so a recording started mid-session replays from a complete
+    /// screen with no output lost or doubled in between.
+    export fn ghostty_surface_set_output_callback(
+        surface: *Surface,
+        cb: ?*const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+        resize_cb: ?*const fn (?*anyopaque, u16, u16) callconv(.c) void,
+        userdata: ?*anyopaque,
+        snapshot: bool,
+    ) void {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+        core_surface.io.output_cb = cb;
+        core_surface.io.resize_cb = resize_cb;
+        core_surface.io.output_userdata = userdata;
+        if (snapshot) snapshotTerminal(&core_surface.io);
+    }
+
+    fn snapshotTerminal(io: anytype) void {
+        const term = &io.terminal;
+        if (io.resize_cb) |cb| cb(io.output_userdata, term.cols, term.rows);
+        const out = io.output_cb orelse return;
+
+        const pages = &term.screens.active.pages;
+        const br = pages.getBottomRight(.active) orelse return;
+        var fmt: terminal.formatter.TerminalFormatter = .init(term, .{
+            .emit = .vt,
+            .trim = false,
+        });
+        fmt.content = .{ .selection = terminal.Selection.init(pages.getTopLeft(.active), br, false) };
+        fmt.extra = .all;
+
+        var aw: std.Io.Writer.Allocating = .init(global.alloc());
+        defer aw.deinit();
+        fmt.format(&aw.writer) catch |err| {
+            log.warn("error formatting terminal snapshot err={}", .{err});
+            return;
+        };
+        const bytes = aw.written();
+        if (bytes.len > 0) out(io.output_userdata, bytes.ptr, bytes.len);
+    }
+
+    /// Feed bytes to the terminal as if the pty had written them. Used to
+    /// replay recordings; the surface's own process should stay quiet.
+    export fn ghostty_surface_feed_output(surface: *Surface, ptr: [*]const u8, len: usize) void {
+        surface.core_surface.io.processOutput(ptr[0..len]);
+    }
+
