+    /// Tap the raw pty output of a surface (before parsing), or clear the
+    /// tap with a null callback. The callback runs on the termio read
+    /// thread with the terminal lock held: copy the bytes and return.
+    export fn ghostty_surface_set_output_callback(
+        surface: *Surface,
+        cb: ?*const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+        userdata: ?*anyopaque,
+    ) void {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+        core_surface.io.output_cb = cb;
+        core_surface.io.output_userdata = userdata;
+    }
+
+    /// Feed bytes to the terminal as if the pty had written them. Used to
+    /// replay recordings; the surface's own process should stay quiet.
+    export fn ghostty_surface_feed_output(surface: *Surface, ptr: [*]const u8, len: usize) void {
+        surface.core_surface.io.processOutput(ptr[0..len]);
+    }
+
