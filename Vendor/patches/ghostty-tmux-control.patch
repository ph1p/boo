+    /// Route tmux control mode (`tmux -CC`) on this surface to `cb` instead
+    /// of the built-in viewer. Pass null to restore the viewer.
+    export fn ghostty_surface_set_tmux_callback(
+        surface: *Surface,
+        cb: ?*const fn (?*anyopaque, u8, [*]const u8, usize) callconv(.c) void,
+        userdata: ?*anyopaque,
+    ) void {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+        const handler = &core_surface.io.terminal_stream.handler;
+        handler.tmux_cb = cb;
+        handler.tmux_userdata = userdata;
+    }
+
+    /// Write bytes to the surface's pty as-is (no paste or key encoding).
+    export fn ghostty_surface_write_pty(surface: *Surface, ptr: [*]const u8, len: usize) void {
+        if (surface.core_surface.readonly) return;
+        const msg = termio.Message.writeReq(surface.core_surface.alloc, ptr[0..len]) catch |err| {
+            log.warn("error allocating pty write err={}", .{err});
+            return;
+        };
+        surface.core_surface.io.queueMessage(msg, .unlocked);
     }
 
